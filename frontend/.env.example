# Copia este archivo como .env y reemplaza la IP por la de tu PC (ipconfig / ifconfig).
# Las variables EXPO_PUBLIC_* quedan dentro de la app: nunca pongas claves secretas aquí.
EXPO_PUBLIC_API_URL=http://192.168.1.20:5000/api

# HU11 - Búsqueda de niñeras por proximidad: clave de Google Maps (Static Maps API)
# para dibujar el mapa de resultados. Como EXPO_PUBLIC_* viaja dentro de la app,
# en Google Cloud Console restringe esta clave solo a "Maps Static API" y a los
# paquetes/orígenes de esta app (no uses aquí una clave sin restricciones).
# Sin esta variable, la pantalla de búsqueda sigue funcionando en modo lista
# (sin la imagen del mapa).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY= 
