// ==========================================================
// PROYECTO: Mi Nana (Ingeniería de Software)
// ORM: Prisma Schema oficial sincronizado con Neon PostgreSQL
// ==========================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id_usuario       Int      @id @default(autoincrement())
  nombre_usuario   String   @db.VarChar(100)
  apellido_usuario String   @db.VarChar(100)
  correo           String   @unique @db.VarChar(150)
  dni              String   @unique @db.VarChar(20)
  contrasena_hash  String   @db.VarChar(255)
  celular          String?  @db.VarChar(20)
  tipo_usuario     String   @db.VarChar(30)
  estado_cuenta    String?  @default("ACTIVA") @db.VarChar(30)
  fecha_registro   DateTime @default(now())
  foto_url         String?
  foto_public_id   String?  @db.VarChar(255)

  padre  Padre?
  ninera Ninera?

  @@map("usuario")
}

model Padre {
  id_padre              Int     @id
  nombre_familia        String? @db.VarChar(150)
  direccion             String? @db.VarChar(255)
  numero_ninos          Int?    @default(0)
  edades_ninos          String? @db.VarChar(100)
  informacion_adicional String?

  usuario Usuario @relation(fields: [id_padre], references: [id_usuario], onDelete: Cascade)
  hijos   Hijo[]
  ofertas OfertaTrabajo[]

  @@map("padre")
}

model Ninera {
  id_ninera             Int      @id
  zona                  String?  @db.VarChar(100)
  experiencia           String?
  tarifa_hora           Decimal  @db.Decimal(10, 2)
  descripcion           String?
  verificada            Boolean  @default(false)
  calificacion_promedio Decimal? @default(5.00) @db.Decimal(3, 2)
  habilidades           String[] @default([])
  idiomas               String[] @default([])
  distritos             String[] @default([])
  // HU11: coordenadas para búsqueda por proximidad (Google Maps API) y
  // años de experiencia en formato numérico para poder filtrar por ellos.
  latitud               Decimal? @db.Decimal(10, 7)
  longitud              Decimal? @db.Decimal(10, 7)
  anos_experiencia      Int?     @db.SmallInt

  usuario       Usuario       @relation(fields: [id_ninera], references: [id_usuario], onDelete: Cascade)
  certificados  Certificado[]
  postulaciones Postulacion[]

  @@map("ninera")
}

model Hijo {
  id_hijo             Int     @id @default(autoincrement())
  id_padre            Int
  nombre_hijo         String  @db.VarChar(100)
  edad                Int
  alergias            String?
  condiciones_medicas String?
  notas               String?

  padre Padre @relation(fields: [id_padre], references: [id_padre], onDelete: Cascade)

  @@map("hijo")
}

// HU8: certificados de la niñera (los CHECK están en database/migrations/001_hu8_multimedia.sql)
model Certificado {
  id_certificado       Int       @id @default(autoincrement())
  id_ninera            Int
  tipo                 String    @db.VarChar(40)
  nombre               String    @db.VarChar(100)
  institucion          String    @db.VarChar(100)
  fecha_emision        DateTime  @db.Date
  fecha_vencimiento    DateTime? @db.Date
  archivo_public_id    String    @db.VarChar(255)
  archivo_formato      String    @db.VarChar(10)
  archivo_tipo_recurso String    @default("image") @db.VarChar(10)
  estado_revision      String    @default("PENDIENTE") @db.VarChar(20)
  fecha_subida         DateTime  @default(now()) @db.Timestamp(6)

  ninera Ninera @relation(fields: [id_ninera], references: [id_ninera], onDelete: Cascade)

  @@index([id_ninera], map: "idx_certificado_ninera")
  @@map("certificado")
}

// HU14: Bolsa de Trabajo (los CHECK están en database/migrations/005_hu14_bolsa_trabajo.sql)
model OfertaTrabajo {
  id_oferta         Int       @id @default(autoincrement())
  id_padre          Int
  titulo            String    @db.VarChar(120)
  descripcion       String
  distrito          String    @db.VarChar(100)
  fecha_inicio      DateTime  @db.Date
  hora_inicio       DateTime  @db.Time(6)
  hora_fin          DateTime  @db.Time(6)
  tarifa_hora       Decimal   @db.Decimal(10, 2)
  numero_ninos      Int       @default(1)
  edades_ninos      String?   @db.VarChar(100)
  requisitos        String?
  estado            String    @default("ABIERTA") @db.VarChar(20)
  fecha_publicacion DateTime? @default(now()) @db.Timestamp(6)

  padre         Padre         @relation(fields: [id_padre], references: [id_padre], onDelete: Cascade)
  postulaciones Postulacion[]

  @@index([estado, fecha_inicio], map: "idx_oferta_trabajo_estado_fecha")
  @@index([id_padre], map: "idx_oferta_trabajo_padre")
  @@map("oferta_trabajo")
}

model Postulacion {
  id_postulacion    Int       @id @default(autoincrement())
  id_oferta         Int
  id_ninera         Int
  mensaje           String?
  estado            String    @default("PENDIENTE") @db.VarChar(20)
  fecha_postulacion DateTime? @default(now()) @db.Timestamp(6)

  oferta OfertaTrabajo @relation(fields: [id_oferta], references: [id_oferta], onDelete: Cascade)
  ninera Ninera        @relation(fields: [id_ninera], references: [id_ninera], onDelete: Cascade)

  @@unique([id_oferta, id_ninera])
  @@index([id_ninera], map: "idx_postulacion_ninera")
  @@map("postulacion")
}
